<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="edu.utsa.cs3443.utsadining.AboutDetailController"
            prefWidth="1440.0"
            prefHeight="900.0"
            styleClass="root-pane"
            stylesheets="@aboutus.css">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="16.0" styleClass="top-bar">
            <padding>
                <Insets top="10" right="18" bottom="10" left="18"/>
            </padding>
            <children>
                <Button text="←" onAction="#goBackHome" styleClass="icon-back-button"/>

                <ImageView fitWidth="34.0" fitHeight="46.0" preserveRatio="true">
                    <image>
                        <Image url="@../../../../assets/utsa-logo.png"/>
                    </image>
                </ImageView>

                <Label fx:id="topPageTitleLabel" styleClass="page-top-title"/>
            </children>
        </HBox>
    </top>

    <center>
        <VBox spacing="22.0" styleClass="detail-page-content">
            <padding>
                <Insets top="26" right="56" bottom="30" left="56"/>
            </padding>
            <children>
                <Label fx:id="headingLabel" styleClass="detail-heading"/>

                <Label fx:id="introLabel"
                       wrapText="true"
                       styleClass="detail-text"/>

                <Label text="What we focus on:" styleClass="detail-subheading"/>

                <Label fx:id="focusPointsLabel"
                       wrapText="true"
                       styleClass="detail-text"/>

                <Label text="Why it matters:" styleClass="detail-subheading"/>

                <Label fx:id="whyItMattersLabel"
                       wrapText="true"
                       styleClass="detail-text"/>
            </children>
        </VBox>
    </center>

</BorderPane>