<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="edu.utsa.cs3443.utsadining.EventDetailsController"
      prefWidth="900" prefHeight="620"
      style="-fx-background-color: #D9D9D9;">

    <padding>
        <Insets top="20" right="50" bottom="30" left="50"/>
    </padding>

    <!-- Top bar -->
    <HBox alignment="CENTER_LEFT" spacing="0">
        <Button text="←" onAction="#handleBackToEvents"
                fx:id="backToEventsButton"
                style="-fx-background-color: transparent; -fx-font-size: 20px; -fx-cursor: hand;"/>
        <Label text="" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
        <Button text="⌂" onAction="#handleBackToDashboard"
                fx:id="backToDashboardButton"
                style="-fx-background-color: transparent; -fx-font-size: 20px; -fx-cursor: hand;"/>
    </HBox>

    <!-- Event Title -->
    <Label fx:id="titleLabel" text=""
           style="-fx-font-size: 36px; -fx-font-weight: bold; -fx-text-fill: #E8490F;">
        <VBox.margin><Insets top="10" bottom="6"/></VBox.margin>
    </Label>

    <!-- Main content row: details on left, image on right -->
    <HBox spacing="40" VBox.vgrow="ALWAYS">

        <!-- Left: detail fields -->
        <VBox spacing="18" HBox.hgrow="ALWAYS">
            <padding><Insets top="10"/></padding>

            <!-- Date -->
            <VBox spacing="3">
                <Label text="DATE"
                       style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #888888;"/>
                <Label fx:id="dateLabel" text=""
                       style="-fx-font-size: 18px; -fx-text-fill: #1a2a4a;"/>
            </VBox>

            <!-- Time -->
            <VBox spacing="3">
                <Label text="TIME"
                       style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #888888;"/>
                <Label fx:id="timeLabel" text=""
                       style="-fx-font-size: 18px; -fx-text-fill: #1a2a4a;"/>
            </VBox>

            <!-- Location -->
            <VBox spacing="3">
                <Label text="LOCATION"
                       style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #888888;"/>
                <Label fx:id="locationLabel" text=""
                       style="-fx-font-size: 18px; -fx-text-fill: #1a2a4a;"/>
            </VBox>

            <!-- Description -->
            <VBox spacing="3">
                <Label text="ABOUT"
                       style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #888888;"/>
                <Label fx:id="descriptionLabel" text=""
                       wrapText="true"
                       style="-fx-font-size: 14px; -fx-text-fill: #333333;" maxWidth="380"/>
            </VBox>
        </VBox>

        <!-- Right: event image -->
        <VBox alignment="CENTER">
            <ImageView fx:id="eventImageView"
                       fitWidth="280" fitHeight="220"
                       preserveRatio="true"
                       style="-fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 12, 0, 0, 4);"/>
        </VBox>
    </HBox>

    <!-- Bottom navigation buttons -->
    <HBox spacing="16" alignment="CENTER_LEFT">
        <VBox.margin><Insets top="20"/></VBox.margin>
        <Button text="← Back to Events" onAction="#handleBackToEvents"
                style="-fx-background-color: #0D1B3E; -fx-text-fill: white;
                       -fx-font-size: 14px; -fx-background-radius: 8;
                       -fx-padding: 10 20; -fx-cursor: hand;"/>
        <Button text="⌂ Dashboard" onAction="#handleBackToDashboard"
                style="-fx-background-color: #E8490F; -fx-text-fill: white;
                       -fx-font-size: 14px; -fx-background-radius: 8;
                       -fx-padding: 10 20; -fx-cursor: hand;"/>
    </HBox>

</VBox>
