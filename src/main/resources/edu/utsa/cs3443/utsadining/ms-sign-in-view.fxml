<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="edu.utsa.cs3443.utsadining.SignUpController"
            styleClass="root-pane"
            stylesheets="@mealplans.css">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="18.0" styleClass="top-bar">
            <padding>
                <Insets top="10" right="18" bottom="10" left="18"/>
            </padding>
            <children>
                <Button text="←" onAction="#goBackToMealPlans" styleClass="icon-back-button"/>
                <Label text="Meal Plan Sign Up" styleClass="page-top-title"/>
            </children>
        </HBox>
    </top>

    <center>
        <VBox alignment="CENTER" spacing="18.0">
            <padding>
                <Insets top="40" right="40" bottom="40" left="40"/>
            </padding>

            <children>
                <Label text="Meal Plan Sign Up" styleClass="section-title"/>

                <Label fx:id="selectedPlanLabel"
                       text="Thank you for choosing a UTSA Meal Plan."
                       wrapText="true"
                       maxWidth="500.0"
                       styleClass="section-subtitle"/>

                <TextField fx:id="nameField"
                           promptText="Enter your full name"
                           maxWidth="360.0"/>

                <TextField fx:id="emailField"
                           promptText="Enter your UTSA email"
                           maxWidth="360.0"/>

                <Button text="Submit Sign Up"
                        onAction="#submitSignUp"
                        styleClass="small-blue-button"/>

                <Label fx:id="messageLabel"
                       text=""
                       wrapText="true"
                       maxWidth="520.0"
                       styleClass="section-subtitle"/>
            </children>
        </VBox>
    </center>

</BorderPane>