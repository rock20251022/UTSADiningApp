<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="edu.utsa.cs3443.utsadining.PlanDetailController"
            styleClass="root-pane"
            stylesheets="@mealplans.css">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="18.0" styleClass="top-bar">
            <padding>
                <Insets top="10" right="18" bottom="10" left="18"/>
            </padding>
            <children>
                <Button text="←" onAction="#goBackHome" styleClass="icon-back-button"/>

                <ImageView fitWidth="38.0" fitHeight="52.0" preserveRatio="true">
                    <image>
                        <Image url="@../assets/utsa-logo.png"/>
                    </image>
                </ImageView>

                <Label fx:id="topPageTitleLabel" styleClass="page-top-title"/>
            </children>
        </HBox>
    </top>

    <center>
        <VBox alignment="CENTER" spacing="22.0" styleClass="detail-content-area">
            <padding>
                <Insets top="34" right="70" bottom="40" left="70"/>
            </padding>
            <children>
                <Label fx:id="planTitleLabel" styleClass="detail-plan-title"/>
                <Label fx:id="priceLabel" styleClass="detail-price"/>
                <Label fx:id="descriptionLabel"
                       styleClass="detail-description"
                       wrapText="true"
                       maxWidth="720.0"/>

                <Label text="What's Included?" styleClass="detail-subheading"/>
                <Label fx:id="includedLabel"
                       styleClass="detail-included"
                       wrapText="true"
                       maxWidth="720.0"/>

                <Label fx:id="bestForLabel"
                       styleClass="detail-bestfor"
                       wrapText="true"
                       maxWidth="720.0"/>

                <Region prefHeight="10.0"/>

                <HBox alignment="CENTER">
                    <children>
                        <Button text="Sign Up" onAction="#goToSignIn" styleClass="big-signup-button"/>
                    </children>
                </HBox>
            </children>
        </VBox>
    </center>

</BorderPane>