                <Font size="37.0" />
            </font>
        </Text>
        <Button fx:id="backToDashboardButton" mnemonicParsing="false" onAction="#handleBackToDashboard" style="-fx-background-color: transparent; -fx-font-size: 20px; -fx-cursor: hand;" text="⌂"/>
